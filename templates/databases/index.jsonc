[
  {
    "id": "blog",
    "name": "Blog",
    "description": "Authors publish tagged posts and readers reply in threads.",
    "tables": ["users", "posts", "tags", "post_tags", "comments"]
  },
  {
    "id": "course-platform",
    "name": "Course Platform",
    "description": "Instructors publish lessons; students enrol and track progress.",
    "tables": [
      "users",
      "courses",
      "sections",
      "lessons",
      "enrollments",
      "lesson_progress",
      "reviews"
    ],
    "views": ["enrollment_progress"]
  },
  {
    "id": "ecommerce",
    "name": "E-commerce Shop",
    "description": "Products and variants, with carts, discounts, and orders.",
    "tables": [
      "customers",
      "addresses",
      "categories",
      "products",
      "product_categories",
      "product_images",
      "product_variants",
      "carts",
      "cart_items",
      "discount_codes",
      "orders",
      "order_items"
    ]
  },
  {
    "id": "event-ticketing",
    "name": "Event Ticketing",
    "description": "Venues run events that sell tickets, scanned at the door.",
    "tables": [
      "venues",
      "events",
      "ticket_types",
      "attendees",
      "orders",
      "tickets"
    ],
    "views": ["ticket_availability"]
  },
  {
    "id": "helpdesk",
    "name": "Helpdesk",
    "description": "Customer tickets with agent replies, internal notes, and tags.",
    "tables": [
      "agents",
      "customers",
      "tickets",
      "ticket_messages",
      "attachments",
      "tags",
      "ticket_tags",
      "canned_responses",
      "satisfaction_ratings"
    ]
  },
  {
    "id": "invoicing",
    "name": "Invoicing",
    "description": "Invoices built from line items, with totals and balances owed.",
    "tables": ["clients", "tax_rates", "invoices", "invoice_items", "payments"],
    "views": ["invoice_item_amounts", "invoice_totals", "invoice_balances"]
  },
  {
    "id": "link-shortener",
    "name": "Link Shortener",
    "description": "Short slugs that redirect to any URL, with click analytics.",
    "tables": ["links", "clicks"],
    "views": ["link_stats"]
  },
  {
    "id": "saas-starter",
    "name": "SaaS Starter",
    "description": "Multi-tenant accounts with API keys, plans, and an audit log.",
    "tables": [
      "users",
      "sessions",
      "organizations",
      "memberships",
      "invitations",
      "api_keys",
      "plans",
      "subscriptions",
      "audit_log"
    ]
  },
  {
    "id": "video-platform",
    "name": "Video Platform",
    "description": "Channels publish Bunny Stream videos, playlists, and comments.",
    "tables": [
      "users",
      "channels",
      "videos",
      "playlists",
      "playlist_videos",
      "watch_progress",
      "reactions",
      "comments",
      "subscriptions"
    ]
  }
]
