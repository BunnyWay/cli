{
  "name": "@bunny.net/stream-import-s3",
  "version": "0.0.0",
  "description": "AWS S3 source adapter for @bunny.net/stream-import: list videos and resolve download URLs for import into bunny.net Stream.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnyWay/cli.git",
    "directory": "packages/stream-import-s3"
  },
  "homepage": "https://github.com/BunnyWay/cli/tree/main/packages/stream-import-s3#readme",
  "bugs": "https://github.com/BunnyWay/cli/issues",
  "keywords": [
    "bunny",
    "bunny.net",
    "stream",
    "video",
    "migration",
    "s3"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@bunny.net/stream-import": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
