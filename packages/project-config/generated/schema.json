{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "name": {
      "type": "string"
    },
    "databases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "scripts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "standalone",
              "middleware",
              "dns"
            ]
          },
          "entry": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scaling": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "regions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "allowed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "containers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "dockerfile": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "registry": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "probes": {
                "type": "object",
                "properties": {
                  "readiness": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "http",
                          "tcp",
                          "grpc"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "port": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "liveness": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "http",
                          "tcp",
                          "grpc"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "port": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "startup": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "http",
                          "tcp",
                          "grpc"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "port": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                }
              },
              "endpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "cdn",
                        "anycast"
                      ]
                    },
                    "ssl": {
                      "type": "boolean"
                    },
                    "ports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "public": {
                            "type": "number"
                          },
                          "container": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "public",
                          "container"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "volumes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "mount": {
                      "type": "string"
                    },
                    "size": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "mount",
                    "size"
                  ]
                }
              }
            }
          }
        }
      },
      "required": [
        "name",
        "containers"
      ]
    }
  },
  "required": [
    "version"
  ]
}
