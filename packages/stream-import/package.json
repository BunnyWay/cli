{
  "name": "@bunny.net/stream-import",
  "version": "0.0.0",
  "description": "Headless engine for importing video libraries into bunny.net Stream: discovery, de-duplication, collection mapping, fetch, and resumable state. Source adapters ship as @bunny.net/stream-import-<source>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnyWay/cli.git",
    "directory": "packages/stream-import"
  },
  "homepage": "https://github.com/BunnyWay/cli/tree/main/packages/stream-import#readme",
  "bugs": "https://github.com/BunnyWay/cli/issues",
  "keywords": [
    "bunny",
    "bunny.net",
    "stream",
    "video",
    "migration",
    "vimeo",
    "s3",
    "wistia",
    "mux",
    "cloudflare-stream",
    "jwplayer",
    "brightcove"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bunny.net/openapi-client": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
