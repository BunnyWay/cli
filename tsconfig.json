{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Resolve the compiled-library packages from source in-repo (no prebuild); npm consumers use their package exports. See AGENTS.md "Publishing".
    "paths": {
      // CLI-internal absolute imports. Only the CLI: packages published via tsc emit paths unrewritten.
      "@/*": ["./packages/cli/src/*"],
      "@bunny.net/database-client": ["./packages/database-client/src/index.ts"],
      "@bunny.net/openapi-client": ["./packages/openapi-client/src/index.ts"],
      "@bunny.net/openapi-client/generated/*": [
        "./packages/openapi-client/src/generated/*"
      ],
      "@bunny.net/openapi-client/*": ["./packages/openapi-client/src/*"],
      "@bunny.net/sandbox": ["./packages/sandbox/src/index.ts"],
      "@bunny.net/stream-import": ["./packages/stream-import/src/index.ts"],
      "@bunny.net/stream-import-brightcove": [
        "./packages/stream-import-brightcove/src/index.ts"
      ],
      "@bunny.net/stream-import-cloudflare": [
        "./packages/stream-import-cloudflare/src/index.ts"
      ],
      "@bunny.net/stream-import-jwplayer": [
        "./packages/stream-import-jwplayer/src/index.ts"
      ],
      "@bunny.net/stream-import-mux": [
        "./packages/stream-import-mux/src/index.ts"
      ],
      "@bunny.net/stream-import-s3": [
        "./packages/stream-import-s3/src/index.ts"
      ],
      "@bunny.net/stream-import-vimeo": [
        "./packages/stream-import-vimeo/src/index.ts"
      ],
      "@bunny.net/stream-import-wistia": [
        "./packages/stream-import-wistia/src/index.ts"
      ],
      "@bunny.net/sandbox/known-hosts": [
        "./packages/sandbox/src/known-hosts.ts"
      ]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": [
    "packages/database-studio/client",
    "packages/*/dist",
    // Standalone projects with their own dependencies, including an @types/node that clashes with bun-types.
    "packages/database-client/examples"
  ]
}
