{
  "name": "@bunny.net/monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/database-client/examples/bun",
    "packages/database-client/examples/node",
    "packages/database-client/examples/hono",
    "packages/database-client/examples/edge-script"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/index.ts",
    "ny": "bun run packages/cli/src/index.ts",
    "build:studio": "bun run --filter @bunny.net/database-studio build:client",
    "build": "bun run build:studio && bun build packages/cli/src/index.ts --compile --outfile bunny",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bun run lint:biome && bun run lint:prettier",
    "lint:ci": "bun run lint:biome:ci && bun run lint:prettier:ci",
    "lint:biome": "biome check --write .",
    "lint:biome:ci": "biome ci",
    "lint:prettier": "prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "lint:prettier:ci": "prettier --check \"**/*.{md,mdx,yml,yaml}\"",
    "openapi:generate": "bun run --filter @bunny.net/openapi-client generate",
    "openapi:update": "bun run --filter @bunny.net/openapi-client update-specs",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/bun": "latest",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^2.1.7",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.9",
    "minimatch": "^5.1.8",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
